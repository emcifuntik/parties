{
  "name": "rmlui",
  "version": "6.3.0",
  "port-version": 7,
  "description": "RmlUi from the original mikke89/RmlUi repository, including the upstream Win32/DX12 backend",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "freetype"
  ],
  "features": {
    "freetype": {
      "description": "Include font engine based on FreeType",
      "dependencies": [
        {
          "name": "freetype",
          "default-features": false
        }
      ]
    },
    "lottie": {
      "description": "Enable plugin for Lottie animations",
      "dependencies": [
        "rlottie"
      ]
    },
    "svg": {
      "description": "Enable plugin for SVG images",
      "dependencies": [
        "lunasvg"
      ]
    }
  }
}
