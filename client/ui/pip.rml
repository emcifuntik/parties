<rml>
<head>
    <title>Parties picture-in-picture</title>
    <link type="text/rcss" href="theme.rcss" />
    <link type="text/rcss" href="typography.rcss" />
    <link type="text/rcss" href="components.rcss" />
    <link type="text/rcss" href="pip.rcss" />
</head>
<!-- Desktop picture-in-picture surface. The host window has no chrome; the
     overlay appears while the cursor is over the window or a control is in
     use. Elements with class "pip-action" are clickable; the rest of the
     window drags it. "pip-keyboard" controls take keyboard focus on click. -->
<body class="pip-body" data-model="pip">
    <video_frame class="pip-video" id="pip-video" />
    <div class="pip-overlay" id="pip-overlay" data-class-visible="overlay_visible">
        <div class="pip-actions">
            <div class="pip-action" id="pip-return" title="Return to Parties" data-event-click="pip_return">
                <span class="ui-symbol">&#x21A9;</span>
            </div>
            <div class="pip-action" id="pip-close" title="Close picture-in-picture" data-event-click="pip_close">
                <span class="ui-symbol">&#xD7;</span>
            </div>
        </div>
        <div class="pip-volume pip-action pip-keyboard" id="pip-volume" title="Stream volume"
             data-class-silent="volume &lt;= 0">
            <svg class="pip-volume-icon" src="icon-volume.svg" width="16" height="16" />
            <input type="range" class="pip-volume-slider ui-range" id="pip-volume-slider"
                   min="0" max="2" step="0.01"
                   data-value="volume"
                   data-event-change="pip_volume_changed"
                   data-event-keydown="pip_volume_key" />
            <span class="pip-volume-value ui-caption" id="pip-volume-value">{{ volume * 100 | format(0) }}%</span>
        </div>
    </div>
</body>
</rml>
