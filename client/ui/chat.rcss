/* Text chat, messages, search, attachments and composer. */

/* ── Chat content ────────────────────────────────────── */

.chat-content {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.chat-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12dp 20dp;
    border-bottom: 1dp #1E2030;
}

.chat-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1;
    gap: 10dp;
}

.chat-header-icon {
    display: block;
    flex: none;
    image-color: #6B7394;
}

.chat-title {
    display: block;
    font-size: 16dp;
    font-weight: bold;
    color: #F0F2F8;
}

.chat-header-desc {
    display: block;
    font-size: 13dp;
    color: #5A5E73;
    margin-left: 4dp;
    padding-left: 12dp;
    border-left: 1dp #2A2D3E;
}

.chat-header-actions {
    display: flex;
    flex-direction: row;
    gap: 8dp;
}

.chat-header-btn {
    display: block;
    padding: 6dp;
    border-radius: 6dp;
    cursor: pointer;
    opacity: 0.5;
}

.chat-header-btn:hover {
    opacity: 1;
    background-color: #252838;
}

/* Search bar */
.chat-search-bar {
    display: flex;
    padding: 8dp 20dp;
    border-bottom: 1dp #1E2030;
}

.chat-search-input {
    display: block;
    flex: 1;
    padding: 8dp 12dp;
    background-color: #181A24;
    border: 1dp #2A2D3E;
    border-radius: 8dp;
    color: #C4C8D8;
    font-size: 13dp;
}

/* Pinned messages panel */
.chat-pinned-panel {
    display: flex;
    flex-direction: column;
    max-height: 200dp;
    overflow-y: auto;
    background-color: #181A24;
    border-bottom: 1dp #1E2030;
    padding: 8dp 20dp;
}

.chat-pinned-header {
    display: flex;
    flex-direction: row;
    margin-bottom: 8dp;
    font-size: 13dp;
    font-weight: bold;
    color: #8A8FA6;
}

.chat-pinned-header span {
    display: block;
    flex: 1;
}

.chat-pinned-empty {
    display: block;
    padding: 8dp;
    text-align: center;
}

/* Date separator */
.date-separator {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12dp;
    padding: 14dp 0;
}

.date-separator-line {
    display: block;
    flex: 1;
    height: 1dp;
    background-color: #2A2D3E;
}

.date-separator-text {
    display: block;
    font-size: 11dp;
    color: #5A5E73;
    font-weight: bold;
}

/* Message list */
.chat-messages {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow-y: auto;
    padding: 4dp 20dp;
}

.chat-load-more {
    display: block;
    text-align: center;
    padding: 8dp;
    color: #7C5CFC;
    font-size: 12dp;
    cursor: pointer;
}

.chat-load-more:hover {
    text-decoration: underline;
}

/* Message row — avatar + body side by side */
.msg-row {
    display: flex;
    flex-direction: row;
    padding: 6dp 20dp;
    margin: 0 -20dp;
}

.msg-row:hover {
    background-color: #1A1D28;
}

/* Avatar — gradient circle with initials overlay */
.msg-avatar-wrap {
    display: flex;
    flex: none;
    width: 32dp;
    height: 32dp;
    margin-right: 10dp;
    margin-top: 2dp;
    justify-content: center;
    align-items: center;
    position: relative;
}

.msg-avatar {
    display: block;
    width: 32dp;
    height: 32dp;
    position: absolute;
    top: 0;
    left: 0;
}

.msg-initials {
    display: block;
    font-size: 11dp;
    font-weight: bold;
    color: #FFFFFF;
    position: relative;
}

/* Message body */
.msg-body {
    display: block;
    flex: 1;
}

.msg-sender {
    font-size: 13dp;
    font-weight: bold;
    color: #F0F2F8;
    margin-right: 4dp;
}

.msg-you {
    font-size: 11dp;
    color: #5A5E73;
    margin-right: 4dp;
}

.msg-time {
    font-size: 11dp;
    color: #5A5E73;
}

.msg-text {
    display: block;
    font-size: 13dp;
    color: #C4C8D8;
    margin-top: 2dp;
}

/* Selectable message text (custom element defaults to inline — force block). */
selectable_text {
    display: block;
    cursor: text;
}

.msg-link {
    color: #7C9BFC;
    cursor: pointer;
}

.msg-link:hover {
    color: #9BB3FF;
    text-decoration: underline;
}

/* Attachment cards */
.msg-attachments {
    display: flex;
    flex-direction: column;
    gap: 6dp;
    margin-top: 8dp;
}

.att-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    padding: 6dp 10dp;
    background-color: #1A1D2A;
    border: 1dp #2A2D3E;
    border-radius: 6dp;
    margin-top: 4dp;
    max-width: 350dp;
}

.att-icon {
    display: block;
    flex: none;
    image-color: #7C9BFC;
}

.att-name {
    display: block;
    flex: 1;
    font-size: 13dp;
    color: #C8CCE0;
}

.att-size {
    display: block;
    font-size: 11dp;
    color: #5A5E73;
}

.att-download-btn {
    display: flex;
    flex: none;
    width: 28dp;
    height: 28dp;
    border-radius: 6dp;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    background-color: #252838;
}

.att-download-btn:hover {
    background-color: #2F3348;
}

.att-download-icon {
    display: block;
    image-color: #7C9BFC;
}

/* Empty state */
.chat-empty {
    display: flex;
    flex: 1;
    justify-content: center;
    align-items: center;
}

/* Unread dot */
.chat-unread-dot {
    display: block;
    width: 6dp;
    height: 6dp;
    background-color: #7C5CFC;
    border-radius: 3dp;
    margin-top: 5dp;
    margin-left: 4dp;
}

.chat-item.unread .chat-item-name {
    color: #F0F2F8;
    font-weight: bold;
}

/* ── Compose area ─────────────────────────────────────── */

.chat-compose {
    display: flex;
    flex-direction: column;
    padding: 12dp 20dp 16dp 20dp;
}

.compose-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
}

.compose-input-wrap {
    display: flex;
    flex-direction: row;
    flex: 1;
    align-items: center;
    background-color: #1A1D2A;
    border: 1dp #2A2D3E;
    border-radius: 22dp;
    padding: 0 4dp 0 0;
}

input.text.compose-input {
    display: block;
    flex: 1;
    padding: 10dp 16dp;
    background-color: #1A1D2A;
    border: 0;
    border-radius: 22dp 0 0 22dp;
    color: #F0F2F8;
    font-size: 14dp;
    margin-bottom: 0;
    width: auto;
}

.compose-attach-btn {
    display: flex;
    flex: none;
    width: 32dp;
    height: 32dp;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    border-radius: 16dp;
}

.compose-attach-btn:hover {
    background-color: #252838;
}

.compose-attach-icon {
    display: block;
    image-color: #5A5E73;
}

.compose-attach-btn:hover .compose-attach-icon {
    image-color: #C4C8D8;
}

.send-btn {
    display: flex;
    flex: none;
    width: 40dp;
    height: 40dp;
    background-color: #6EECD4;
    border-radius: 20dp;
    justify-content: center;
    align-items: center;
    cursor: pointer;
}

.send-btn:hover {
    background-color: #5DD8C2;
}

.send-icon {
    display: block;
    image-color: #0E1018;
}

/* Pending files */
.pending-files {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6dp;
    padding-bottom: 10dp;
}

.pending-file {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    padding: 6dp 10dp;
    background-color: #1A1D2A;
    border-radius: 6dp;
    border: 1dp #2A2D3E;
}

.pending-file-name {
    display: block;
    font-size: 12dp;
    color: #C8CCE0;
}

.pending-file-size {
    display: block;
    font-size: 10dp;
    color: #5A5E73;
}

.pending-file-remove {
    display: block;
    width: 16dp;
    height: 16dp;
    font-size: 12dp;
    color: #5A5E73;
    text-align: center;
    line-height: 16dp;
    cursor: pointer;
    border-radius: 3dp;
}

.pending-file-remove:hover {
    color: #FF6B6B;
    background-color: #3D1515;
}

/* Chat visual composition. */
/* Chat */
.chat-welcome {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14dp;
    padding: 54dp 18dp 24dp 18dp;
}
.chat-welcome-icon {
    display: flex;
    width: 48dp;
    height: 48dp;
    align-items: center;
    justify-content: center;
    background-color: #17221F;
    color: #5EEAD4;
    border-radius: 15dp;
}
.chat-welcome-icon svg { display: block; image-color: #5EEAD4; }
.chat-welcome-copy-block { display: flex; min-width: 0dp; flex-direction: column; }
.chat-welcome-title { margin-top: 0dp; color: #EEF1F6; }
.chat-welcome-copy { margin-top: 4dp; color: #6F7987; }
.msg-row { padding-top: 8dp; padding-bottom: 8dp; border-radius: 8dp; }
.msg-row:hover { background-color: #0F141B; }
