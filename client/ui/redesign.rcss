/* Parties UI v2 — migration layer
   New screens and shared primitives live here. Legacy selectors remain in
   style.rcss until their feature is migrated, keeping rollout incremental. */

/* Native RmlUI custom properties. Tokens cascade through the document and can
   be overridden locally without recompiling the stylesheet. */
body {
    --color-canvas: #0A0C11;
    --color-shell: #0D1118;
    --color-surface: #10141C;
    --color-surface-raised: #151B25;
    --color-surface-hover: #1B222D;
    --color-border: #FFFFFF0F;
    --color-border-strong: #FFFFFF1F;
    --color-text: #EEF1F6;
    --color-text-soft: #AAB2BE;
    --color-text-muted: #687280;
    --color-text-faint: #4F5967;
    --color-accent: #5EEAD4;
    --color-accent-hover: #79F3DE;
    --color-accent-ink: #06231F;
    --color-success: #34D399;
    --color-danger: #F87171;
    --color-warning: #FBBF24;
    --radius-sm: 8dp;
    --radius-md: 12dp;
    --radius-lg: 16dp;
    --radius-pill: 999dp;
    --space-1: 4dp;
    --space-2: 8dp;
    --space-3: 12dp;
    --space-4: 16dp;
    --space-5: 20dp;
    --space-6: 24dp;
    --titlebar-height: 38dp;
    --sidebar-width: 286dp;
}

/* Foundation */
body {
    font-family: Inter;
    font-size: 14dp;
    color: var(--color-text);
}

.fullscreen { background-color: var(--color-canvas); }
.app-content { background-color: var(--color-canvas); }

.titlebar {
    height: var(--titlebar-height);
    padding-left: 2dp;
    background-color: var(--color-canvas);
    border-bottom: 1dp var(--color-border);
}

.titlebar-title {
    color: #9AA3B0;
    letter-spacing: 0.6dp;
}

.titlebar-stats span { color: #4B5563; }
.titlebar-btn { background-color: #0B0E13; }
.titlebar-btn:hover { background-color: #171C25; }

/* Launcher */
.home-screen { background-color: #0A0C11; }
.home-inner { background-color: #0A0C11; }
.home-content { padding: 54dp 64dp; }
.home-toolbar {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 34dp;
}
.home-greeting { margin-bottom: 0dp; }
.home-eyebrow { display: block; color: #7C8695; font-size: 13dp; }
.home-title {
    color: #EEF1F6;
    font-size: 30dp;
    letter-spacing: -0.7dp;
}
.home-subtitle { color: #7C8695; margin-top: 7dp; }
.home-actions { display: flex; flex-direction: row; align-items: center; gap: 12dp; }
.home-profile {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    padding: 7dp 12dp 7dp 8dp;
    background-color: #10141C;
    border: 1dp #FFFFFF0F;
    border-radius: 22dp;
}
.home-profile-avatar { display: block; width: 26dp; height: 26dp; }
.home-profile-name { color: #DFE4EC; font-size: 12dp; font-weight: bold; }
.home-add-button {
    display: block;
    padding: 11dp 17dp;
    background-color: #5EEAD4;
    color: #06231F;
    border-radius: 10dp;
    font-size: 12dp;
    font-weight: bold;
    cursor: pointer;
}
.home-add-button:hover { background-color: #79F3DE; }
.home-grid { gap: 20dp; max-width: none; }
.party-card {
    width: 290dp;
    height: 238dp;
    padding: 0dp;
    box-sizing: border-box;
    align-items: stretch;
    background-color: #10141C;
    border: 1dp #FFFFFF0F;
    border-radius: 16dp;
}
.party-card-banner {
    display: block;
    flex: none;
    height: 72dp;
    background-color: #29364A;
    border-radius: 16dp 16dp 0dp 0dp;
}
.party-card-banner.variant-one { background-color: #3B304C; }
.party-card-banner.variant-two { background-color: #253E4B; }
.party-card-banner.variant-three { background-color: #3E3039; }
.party-card-banner.offline { background-color: #222631; }
.party-card-body {
    display: flex;
    flex-direction: column;
    position: relative;
    flex: 1;
    padding: 0dp 18dp 16dp 18dp;
    margin-top: -25dp;
}
.party-card .party-card-icon-wrap { margin-bottom: 8dp; }
.party-card .party-card-name { text-align: left; font-size: 16dp; }
.party-card .party-card-status { justify-content: flex-start; }
.party-card-footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: auto;
}
.party-card-host { display: block; flex: 1; color: #596473; font-size: 10dp; }
.party-card-action {
    display: block;
    padding: 8dp 14dp;
    background-color: #5EEAD4;
    color: #06231F;
    border-radius: 8dp;
    font-size: 11dp;
    font-weight: bold;
}
.party-card-action.secondary { background-color: #171D26; color: #9AA3B0; border: 1dp #FFFFFF14; }
.party-card:hover {
    background-color: #151B25;
    border-color: #5EEAD459;
}
.party-card.online { border-color: #5EEAD438; }
.party-card-name { color: #E8ECF2; font-size: 15dp; }
.party-card-users { color: #8B93A1; }
.status-dot.online { background-color: #34D399; }
.party-card-add {
    height: 238dp;
    border: 1dp #FFFFFF1F;
    background-color: transparent;
    justify-content: center;
    align-items: center;
}
.party-card-icon-add { background-color: #151B25; border: 1dp #FFFFFF12; }
.party-card-plus { color: #5EEAD4; }

/* Connected shell */
.sidebar {
    width: 286dp;
    background-color: #0D1118;
    border-right: 1dp #FFFFFF0D;
}
.server-header {
    min-height: 74dp;
    padding: 14dp 16dp;
    background-color: #0D1118;
    border-bottom: 1dp #FFFFFF0D;
}
.server-header .server-title { color: #EEF1F6; font-size: 15dp; }
.channel-section { padding: 13dp 10dp; }
.channel-category {
    color: #5B6470;
    font-size: 10dp;
    letter-spacing: 1.2dp;
}
.channel-item, .chat-item {
    min-height: 36dp;
    margin: 2dp 0;
    padding: 0 10dp;
    border-radius: 9dp;
}
.channel-item:hover, .chat-item:hover { background-color: #141923; }
.channel-item.active, .chat-item.active {
    background-color: #17221F;
    color: #DFFBF5;
}
.channel-item.active .channel-icon, .chat-item.active .chat-icon { image-color: #5EEAD4; }
.channel-user-item { margin-left: 11dp; border-radius: 8dp; }
.channel-user-item:hover { background-color: #141923; }
.user-island {
    margin: 10dp;
    padding: 10dp;
    background-color: #121720;
    border: 1dp #FFFFFF0F;
    border-radius: 14dp;
}
.voice-btn {
    height: 38dp;
    border-radius: 10dp;
    background-color: #181E28;
}
.voice-btn:hover { background-color: #202834; }
.voice-btn.active { background-color: #3A1D24; }
.voice-btn.audio-share-button.active { background-color: #17312D; }
.voice-btn.audio-share-button.active svg { image-color: var(--color-accent); }
.main-content { background-color: #0A0C11; }

/* Room header and stage */
.channel-header {
    min-height: 74dp;
    padding: 14dp 22dp;
    background-color: #0A0C11;
    border-bottom: 1dp #FFFFFF0D;
}
.channel-heading { display: flex; flex-direction: column; flex: 1; }
.channel-kicker {
    display: block;
    color: #5EEAD4;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1.1dp;
    text-transform: uppercase;
}
.channel-header .channel-title {
    margin-top: 4dp;
    color: #EEF1F6;
    font-size: 18dp;
}
.channel-header .channel-hint { color: #687280; font-size: 12dp; }
.voice-stage {
    display: flex;
    flex: 1;
    padding: 24dp;
    overflow-y: auto;
}
.voice-stage-room { display: flex; flex-direction: column; flex: 1; }
.voice-stage-summary {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 18dp;
}
.voice-stage-count { color: #AAB2BE; font-size: 13dp; font-weight: bold; }
.voice-stage-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12dp;
    align-content: flex-start;
}
.voice-stage-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 210dp;
    height: 176dp;
    background-color: #10141C;
    border: 1dp #FFFFFF0F;
    border-radius: 16dp;
}
.voice-stage-card:hover { background-color: #141A23; border-color: #FFFFFF1A; }
.voice-stage-card.speaking { border-color: #5EEAD4; background-color: #10201E; }
.voice-stage-avatar-wrap {
    display: flex;
    position: relative;
    width: 68dp;
    height: 68dp;
    align-items: center;
    justify-content: center;
}
.voice-stage-avatar { position: absolute; width: 68dp; height: 68dp; }
.voice-stage-initial {
    display: block;
    position: relative;
    width: 42dp;
    overflow: hidden;
    white-space: nowrap;
    text-align: center;
    color: #FFFFFF;
    font-size: 12dp;
    font-weight: bold;
}
.voice-stage-speaking {
    display: block;
    position: absolute;
    right: 0dp;
    bottom: 2dp;
    width: 13dp;
    height: 13dp;
    background-color: #5EEAD4;
    border: 3dp #10141C;
    border-radius: 8dp;
}
.voice-stage-name { margin-top: 13dp; color: #E8ECF2; font-size: 14dp; font-weight: bold; }
.voice-stage-state { margin-top: 4dp; color: #697381; font-size: 11dp; }
.voice-stage-card.speaking .voice-stage-state { color: #5EEAD4; }

/* Streams */
.screen-share-area { padding: 18dp; }
.screen-share-header {
    min-height: 48dp;
    padding: 8dp 10dp;
    background-color: #0E1219;
    border: 1dp #FFFFFF0D;
    border-radius: 12dp;
}
.stream-grid { gap: 10dp; margin-top: 10dp; }
.stream-cell { margin: 0dp; }
.stream-cell-video { background-color: #07090D; border: 1dp #FFFFFF0D; border-radius: 14dp; }
.stream-cell-label { color: #8B93A1; padding: 7dp 4dp; }
.sharer-tab { background-color: #151A23; border-radius: 8dp; }
.sharer-tab.active { background-color: #17312D; color: #5EEAD4; }

/* Settings and modals */
.share-picker-overlay {
    padding: 28dp 34dp;
    background-color: #0A0C11;
}
.share-picker-header {
    padding-bottom: 18dp;
    border-bottom: 1dp #FFFFFF0D;
}
.share-picker-header h2 { color: #EEF1F6; font-size: 24dp; }

.settings-overlay {
    --settings-type-page-title: 20dp;
    --settings-type-section: 10dp;
    --settings-type-item-title: 13dp;
    --settings-type-body: 12dp;
    --settings-type-description: 10dp;
    --settings-type-control: 12dp;
    --settings-type-meta: 10dp;
    display: flex;
    flex-direction: row;
    flex: 1;
    padding: 0dp;
    background-color: #0A0C11;
    color: var(--color-text);
    font-family: Inter;
    font-size: var(--settings-type-body);
    font-style: normal;
    font-weight: normal;
    overflow: hidden;
}
.settings-nav {
    display: flex;
    flex-direction: column;
    width: var(--sidebar-width);
    flex-shrink: 0;
    padding: 28dp 14dp 18dp 14dp;
    box-sizing: border-box;
    background-color: #0D1016;
    border-right: 1dp #FFFFFF0D;
}
.settings-nav-title {
    margin: 0dp 10dp 22dp 10dp;
    color: #EEF1F6;
    font-size: var(--settings-type-page-title);
    font-weight: bold;
    line-height: 24dp;
}
.settings-nav-group {
    margin: 12dp 10dp 7dp 10dp;
    color: #596371;
    font-size: var(--settings-type-section);
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
}
.settings-nav-item {
    display: flex;
    align-items: center;
    height: 38dp;
    margin-bottom: 3dp;
    padding: 0dp 10dp;
    color: #838D9B;
    font-size: var(--settings-type-item-title);
    font-style: normal;
    font-weight: normal;
    line-height: 16dp;
    border-radius: 9dp;
    cursor: pointer;
}
.settings-nav-item:hover { background-color: #131821; color: #D6DCE5; }
.settings-nav-item.active {
    background-color: #17221F;
    color: #6EECD4;
}
.settings-nav-icon {
    display: flex;
    width: 22dp;
    height: 22dp;
    align-items: center;
    justify-content: center;
    margin-right: 10dp;
    background-color: #171C25;
    border-radius: 6dp;
}
.settings-nav-icon svg { display: block; image-color: #737E8D; }
.settings-nav-item.active .settings-nav-icon { background-color: #214139; }
.settings-nav-item.active .settings-nav-icon svg { image-color: #6EECD4; }

.settings-page {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0dp;
}
.settings-header {
    display: flex;
    flex-shrink: 0;
    height: 62dp;
    align-items: center;
    justify-content: space-between;
    margin: 0dp;
    padding: 0dp 32dp;
    border-bottom: 1dp #FFFFFF0D;
}
.settings-header h2 {
    color: #EEF1F6;
    font-size: var(--settings-type-page-title);
    font-style: normal;
    font-weight: bold;
    line-height: 24dp;
}
.settings-close {
    display: flex;
    width: 32dp;
    height: 32dp;
    align-items: center;
    justify-content: center;
    background-color: #12161E;
    border: 1dp #FFFFFF12;
    border-radius: 9dp;
    cursor: pointer;
}
.settings-close svg { display: block; image-color: #7D8795; }
.settings-close:hover { background-color: #181E28; }
.settings-close:hover svg { image-color: #D6DCE5; }
.settings-scroll {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 28dp 32dp 30dp 32dp;
    overflow: auto;
}
.settings-device-grid {
    display: flex;
    flex-direction: row;
    gap: 20dp;
}
.settings-device-field {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0dp;
}
.settings-field-label {
    color: #5B6470;
    font-size: var(--settings-type-section);
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
}
.settings-device-select-wrap {
    position: relative;
    display: block;
    height: 48dp;
    margin-top: 10dp;
    padding: 0dp;
    box-sizing: border-box;
    background-color: #10141C;
    border: 1dp #5EEAD44D;
    border-radius: 12dp;
}
.settings-device-select-wrap:hover { border-color: #5EEAD475; background-color: #111720; }
.settings-device-select-wrap:focus-visible { border-color: #5EEAD4B8; }
.settings-device-select-wrap > svg {
    position: absolute;
    display: block;
    left: 13dp;
    top: 15dp;
    image-color: #5EEAD4;
    pointer-events: none;
}
select.settings-device-select {
    display: block;
    width: 100%;
    height: 46dp;
    padding: 0dp;
    background-color: transparent;
    color: #EEF1F6;
    border: 0dp;
    font-size: var(--settings-type-control);
    font-weight: bold;
    line-height: 16dp;
    cursor: pointer;
}
select.settings-device-select selectvalue {
    display: block;
    width: auto;
    height: 16dp;
    margin-right: 36dp;
    padding: 15dp 6dp 15dp 38dp;
    color: #EEF1F6;
    overflow: hidden;
}
select.settings-device-select selectarrow {
    width: 10dp;
    height: 10dp;
    margin-top: 17dp;
    margin-right: 13dp;
    background-color: transparent;
    border-right: 2dp #7D8795;
    border-bottom: 2dp #7D8795;
    transform: rotate(45deg);
    transform-origin: 50% 50%;
    transition: transform border-color 0.16s cubic-out;
}
select.settings-device-select:hover selectarrow { border-color: #B8C0CC; }
select.settings-device-select selectarrow:checked {
    border-color: #5EEAD4;
    transform: rotate(225deg);
}
select.settings-device-select selectbox {
    width: 100%;
    max-height: 232dp;
    margin-top: 6dp;
    padding: 6dp;
    box-sizing: border-box;
    background-color: #111720;
    border: 1dp #27313F;
    border-radius: 10dp;
    color: #C7CED8;
}
select.settings-device-select selectbox option {
    display: block;
    width: auto;
    height: 16dp;
    padding: 10dp 12dp;
    background-color: transparent;
    color: #AAB3C0;
    border-radius: 7dp;
    font-size: var(--settings-type-control);
    font-weight: normal;
    line-height: 16dp;
    cursor: pointer;
}
select.settings-device-select selectbox option:hover {
    background-color: #1A2330;
    color: #EEF1F6;
}
select.settings-device-select selectbox option:checked {
    background-color: #15312D;
    color: #6EF2DD;
    font-weight: bold;
}
.settings-meter-row {
    display: flex;
    height: 24dp;
    align-items: center;
    margin-top: 7dp;
    color: #8B93A1;
    font-size: var(--settings-type-meta);
}
.settings-meter-row > span { width: 34dp; flex-shrink: 0; }
.settings-mic-meter { display: block; flex: 1; height: 7dp; }
.settings-test-output {
    display: flex;
    height: 32dp;
    align-items: center;
    justify-content: center;
    gap: 7dp;
    margin-top: 7dp;
    background-color: #12161E;
    color: #C2C8D2;
    border: 1dp #FFFFFF14;
    border-radius: 9dp;
    font-size: var(--settings-type-control);
    font-weight: bold;
    cursor: pointer;
}
.settings-test-output svg { display: block; image-color: #9AA3B0; }
.settings-test-output:hover { border-color: #5EEAD466; color: #EEF1F6; }

/* Shared range component for notification, music, PTT and stream-quality settings. */
input.settings-wide-slider { display: block; width: 100%; height: 16dp; margin-top: 8dp; }
input.settings-wide-slider slidertrack { height: 5dp; margin-top: 5dp; background-color: #0C0F15; border-radius: 4dp; }
input.settings-wide-slider sliderprogress { height: 5dp; background-color: #5EEAD4; border-radius: 4dp; }
input.settings-wide-slider sliderbar {
    width: 13dp;
    height: 13dp;
    margin: 1dp -6dp 0dp -6dp;
    background-color: #FFFFFF;
    border: 0dp;
    border-radius: 7dp;
}
input.settings-wide-slider sliderbar:hover,
input.settings-wide-slider sliderbar:active {
    width: 13dp;
    height: 13dp;
    margin: 1dp -6dp 0dp -6dp;
    background-color: #FFFFFF;
    border-radius: 7dp;
}

.settings-feature-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12dp;
    margin-top: 24dp;
}
.settings-feature-card {
    display: flex;
    width: 48%;
    min-width: 300dp;
    flex-grow: 1;
    min-height: 64dp;
    box-sizing: border-box;
    align-items: center;
    justify-content: space-between;
    padding: 12dp 16dp;
    background-color: #10141C;
    border: 1dp #FFFFFF0F;
    border-radius: 12dp;
    cursor: pointer;
}
.settings-feature-card > div { display: flex; flex-direction: column; min-width: 0dp; }
.settings-feature-card:hover { border-color: #5EEAD43D; }
.settings-feature-title {
    display: block;
    color: #EEF1F6;
    font-size: var(--settings-type-item-title);
    font-style: normal;
    font-weight: bold;
    line-height: 16dp;
}
.settings-feature-copy {
    display: block;
    margin-top: 3dp;
    color: #8B93A1;
    font-size: var(--settings-type-description);
    font-style: normal;
    font-weight: normal;
    line-height: 14dp;
}
.settings-switch {
    display: block;
    width: 42dp;
    height: 24dp;
    flex-shrink: 0;
    padding: 3dp;
    box-sizing: border-box;
    background-color: #1B212C;
    border: 1dp #FFFFFF0A;
    border-radius: 12dp;
    cursor: pointer;
    transition: background-color border-color 0.16s cubic-out;
}
.settings-switch-knob {
    display: block;
    width: 16dp;
    height: 16dp;
    margin-left: 0dp;
    box-sizing: border-box;
    background-color: #667180;
    border-radius: 8dp;
    transition: margin-left background-color 0.16s cubic-out;
}
.settings-feature-card:hover .settings-switch { border-color: #FFFFFF1A; }
.settings-switch.on { background-color: #5EEAD4; border-color: #5EEAD4; }
.settings-switch.on .settings-switch-knob { margin-left: 18dp; background-color: #07352F; }
.settings-ptt-card {
    flex-direction: column;
    align-items: stretch;
    cursor: default;
}
.settings-ptt-card > .settings-ptt-card-header {
    display: flex;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
}
.settings-ptt-card-copy { display: flex; flex-direction: column; min-width: 0dp; }

.settings-level-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12dp;
    margin-top: 12dp;
}
.settings-level-card {
    display: flex;
    flex-direction: column;
    width: 31%;
    min-width: 280dp;
    min-height: 92dp;
    flex-grow: 1;
    box-sizing: border-box;
    padding: 14dp 16dp;
    background-color: #10141C;
    border: 1dp #FFFFFF0F;
    border-radius: 12dp;
}
.settings-level-heading { display: flex; align-items: center; justify-content: space-between; }
.settings-level-heading > div { display: flex; flex-direction: column; min-width: 0dp; }
.settings-level-value, .settings-meta-value {
    color: #8B93A1;
    font-size: var(--settings-type-meta);
    font-style: normal;
    font-weight: normal;
    line-height: 14dp;
}
.settings-level-card input.settings-wide-slider { margin-top: 14dp; }
.settings-vad-card { border-color: #5EEAD429; }
.settings-vad-heading { display: flex; align-items: center; justify-content: space-between; }
.settings-vad-heading > div { display: flex; align-items: center; }
.settings-vad-heading > .settings-vad-title { flex-direction: column; align-items: flex-start; min-width: 0dp; }
.settings-vad-toggle {
    display: flex;
    align-items: center;
    cursor: pointer;
}
.settings-vad-card.disabled { border-color: #FFFFFF0F; }
.settings-vad-card.disabled .settings-vad-meter { opacity: 0.42; }
.settings-vad-card.disabled .settings-vad-foot { opacity: 0.55; }
.settings-vad-track { position: relative; display: block; height: 18dp; margin-top: 11dp; }
.settings-vad-meter {
    display: block;
    width: 100%;
    height: 8dp;
    margin-top: 5dp;
    background-color: #090D13;
    border-radius: 4dp;
    overflow: hidden;
}
input.settings-vad-slider {
    position: absolute;
    display: block;
    left: 0dp;
    top: 0dp;
    width: 100%;
    height: 18dp;
    background-color: transparent;
}
input.settings-vad-slider slidertrack { height: 8dp; margin-top: 5dp; background-color: transparent; }
input.settings-vad-slider sliderprogress { height: 8dp; background-color: transparent; }
input.settings-vad-slider sliderbar {
    width: 4dp;
    height: 18dp;
    margin-top: 0dp;
    margin-left: -2dp;
    box-sizing: border-box;
    background-color: #A78BFA;
    border: 1dp #D8CBFF;
    border-radius: 2dp;
    transition: background-color 0.12s cubic-out;
}
input.settings-vad-slider sliderbar:hover,
input.settings-vad-slider sliderbar:active { background-color: #C4B5FD; }
.settings-vad-foot { display: flex; justify-content: flex-end; margin-top: 4dp; color: #A78BFA; font-size: var(--settings-type-meta); line-height: 14dp; }

.settings-keycap {
    display: flex;
    min-width: 42dp;
    height: 29dp;
    align-items: center;
    justify-content: center;
    padding: 0dp 10dp;
    background-color: #12161E;
    color: #DFE4EC;
    border: 1dp #FFFFFF1F;
    border-radius: 8dp;
    font-size: var(--settings-type-control);
    font-weight: bold;
    cursor: pointer;
}
.settings-keycap:hover { border-color: #5EEAD466; }
.settings-ptt-card > .settings-ptt-delay {
    display: flex;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 12dp;
    margin-top: 10dp;
}
.settings-ptt-card > .settings-ptt-delay input.settings-ptt-delay-slider {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 0dp;
}
.settings-ptt-delay-value {
    display: flex;
    width: 72dp;
    height: 29dp;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: #12161E;
    color: #DFE4EC;
    border: 1dp #FFFFFF1F;
    border-radius: 8dp;
    font-size: var(--settings-type-control);
    font-weight: bold;
}
.settings-ptt-delay-value > span { display: block; color: #DFE4EC; }
.settings-ptt-delay.inactive { opacity: 0.62; }
.settings-page-intro {
    max-width: 700dp;
    margin-bottom: 18dp;
    color: #8B93A1;
    font-size: var(--settings-type-body);
    font-style: normal;
    font-weight: normal;
    line-height: 18dp;
}
.settings-config-card {
    display: flex;
    flex-direction: column;
    max-width: 820dp;
    padding: 20dp;
    background-color: #10141C;
    border: 1dp #FFFFFF0F;
    border-radius: 13dp;
}
.settings-config-card .share-setting-group { margin-bottom: 20dp; }
.settings-config-card .share-codec-buttons { margin-top: 9dp; }
.settings-config-card .share-codec-btn {
    font-size: var(--settings-type-control);
    font-style: normal;
    font-weight: bold;
    line-height: 16dp;
}
.settings-keybind-row, .settings-account-row {
    display: flex;
    min-height: 58dp;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1dp #FFFFFF0D;
}
.settings-row-copy { display: flex; flex-direction: column; min-width: 0dp; }
.settings-keybind-delay { padding-top: 18dp; }
.settings-account-row > div:first-child { display: flex; flex-direction: column; }
.settings-secondary-action, .settings-danger-action {
    display: flex;
    min-height: 32dp;
    align-items: center;
    justify-content: center;
    margin: 8dp 0dp;
    padding: 0dp 13dp;
    background-color: #151A23;
    color: #C2C8D2;
    border: 1dp #FFFFFF14;
    border-radius: 8dp;
    font-size: var(--settings-type-control);
    font-style: normal;
    font-weight: bold;
    line-height: 16dp;
    cursor: pointer;
}
.settings-secondary-action > span { display: block; color: #C2C8D2; }
.settings-danger-action > span { display: block; color: #FCA5A5; }
.settings-danger-action { background-color: #3B1D23; color: #FCA5A5; border-color: #F8717138; }
.settings-slider-heading {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
}
.settings-bitrate-value {
    color: var(--color-text);
}
.settings-overlay .seed-phrase-display {
    font-size: var(--settings-type-body);
    font-style: normal;
    font-weight: normal;
}
.settings-overlay .private-key-text {
    font-size: var(--settings-type-description);
    font-style: normal;
    font-weight: normal;
    line-height: 15dp;
}
.settings-overlay .import-identity-form { font-size: var(--settings-type-body); }
.settings-overlay input.restore-input {
    font-size: var(--settings-type-control);
    font-style: normal;
    font-weight: normal;
    line-height: 17dp;
}
.settings-overlay .error-text {
    font-size: var(--settings-type-description);
    font-style: normal;
    font-weight: normal;
    line-height: 14dp;
}
.route-page { display: flex; flex: 1; min-width: 0dp; min-height: 0dp; }
.route-chat .chat-content { flex: 1; min-width: 0dp; }
.device-item, .share-target-item, .keybind-btn {
    background-color: #151A23;
    border: 1dp #FFFFFF0F;
    border-radius: 9dp;
}
.device-item:hover, .share-target-item:hover { background-color: #1B222D; }
.device-item.selected { border-color: #5EEAD4; color: #DFFBF5; }
.toggle-indicator.on { background-color: #5EEAD4; }
.send-btn { background-color: #5EEAD4; }
.compose-input-wrap, input.text.compose-input { background-color: #121720; }

/* Chat */
.chat-welcome {
    display: flex;
    flex-direction: column;
    padding: 54dp 18dp 24dp 18dp;
}
.chat-welcome-icon {
    display: flex;
    width: 48dp;
    height: 48dp;
    align-items: center;
    justify-content: center;
    background-color: #17221F;
    color: #5EEAD4;
    border-radius: 15dp;
    font-size: 23dp;
    font-weight: bold;
}
.chat-welcome-icon svg { display: block; image-color: #5EEAD4; }
.chat-welcome-title { margin-top: 16dp; color: #EEF1F6; font-size: 22dp; font-weight: bold; }
.chat-welcome-copy { margin-top: 7dp; color: #6F7987; font-size: 12dp; }
.msg-row { padding-top: 8dp; padding-bottom: 8dp; border-radius: 8dp; }
.msg-row:hover { background-color: #0F141B; }

/* Responsive desktop */
@media (max-width: 1100dp) {
    .sidebar, .settings-nav { width: 250dp; }
    .voice-stage-card { width: 180dp; }
    .channel-header .channel-hint { display: none; }
}

/* Enterprise connected shell ------------------------------------------------ */
/* Voice room ---------------------------------------------------------------- */
.voice-stage { padding: 18dp 22dp 22dp 22dp; }
.voice-stage-summary { margin-bottom: 12dp; }
.voice-stage-grid {
    gap: 12dp;
    flex-grow: 0;
    flex-shrink: 0;
    align-content: flex-start;
    justify-content: flex-start;
}
.voice-stage-card {
    position: relative;
    width: 31%;
    height: 246dp;
    min-width: 230dp;
    box-sizing: border-box;
    overflow: hidden;
    background-color: var(--color-surface);
    border: 1dp var(--color-border);
    border-radius: var(--radius-lg);
}
.voice-stage-card.streaming {
    cursor: pointer;
}
.voice-stage-camera-pattern {
    display: flex;
    position: absolute;
    left: 0dp;
    top: 0dp;
    right: 0dp;
    bottom: 0dp;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    padding: 12dp 0dp;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 0.14;
}
.voice-stage-camera-row {
    display: flex;
    position: relative;
    width: 120%;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-around;
}
.voice-stage-camera-row svg {
    display: block;
    width: 18dp;
    height: 18dp;
    flex-shrink: 0;
    image-color: var(--color-accent);
}
.voice-stage-camera-row.row-1 { left: -50dp; }
.voice-stage-camera-row.row-2 { left: -30dp; }
.voice-stage-camera-row.row-3 { left: -10dp; }
.voice-stage-camera-row.row-4 { left: 10dp; }
.voice-stage-camera-row.row-5 { left: 30dp; }
.voice-stage-camera-row.row-6 { left: 50dp; }
.voice-stage-card.streaming .voice-stage-avatar-wrap,
.voice-stage-card.streaming .voice-stage-name,
.voice-stage-card.streaming .voice-stage-state { position: relative; }

/* Stream layouts ------------------------------------------------------------ */
.screen-share-area {
    position: relative;
    padding: 12dp 14dp 74dp 14dp;
    background-color: #07090D;
}
.screen-share-header {
    min-height: 52dp;
    margin: 0dp 0dp 10dp 0dp;
    padding: 0dp 12dp;
    background-color: var(--color-surface);
    border: 1dp var(--color-border);
    border-radius: var(--radius-md);
}
.stream-room-context { display: flex; align-items: center; gap: 8dp; margin-right: 12dp; }
.stream-room-live { padding: 3dp 6dp; background-color: #EF4444; color: #FFFFFF; border-radius: 4dp; font-size: 8dp; font-weight: bold; }
.stream-room-name { color: var(--color-text); font-size: 12dp; font-weight: bold; }
.stream-playback-tools { display: flex; flex-shrink: 0; align-items: center; gap: 7dp; margin-left: 10dp; }
.stream-volume-control {
    display: flex;
    width: 126dp;
    height: 32dp;
    align-items: center;
    gap: 8dp;
    margin: 0dp;
    padding: 0dp 10dp;
    box-sizing: border-box;
    background-color: #0A0E14;
    border: 1dp var(--color-border);
    border-radius: 9dp;
}
.stream-volume-icon { display: block; flex-shrink: 0; opacity: 1; image-color: var(--color-text-muted); }
.stream-volume-slider { display: block; flex: 1; width: auto; height: 16dp; }
input.range.stream-volume-slider slidertrack { height: 4dp; margin-top: 6dp; background-color: #293240; border-radius: 2dp; }
input.range.stream-volume-slider sliderprogress { height: 4dp; background-color: var(--color-accent); border-radius: 2dp; }
input.range.stream-volume-slider sliderbar {
    width: 12dp;
    height: 12dp;
    margin: 2dp -6dp 0dp -6dp;
    box-sizing: border-box;
    background-color: #E8FFFB;
    border: 2dp #0A0E14;
    border-radius: 6dp;
}
input.range.stream-volume-slider sliderbar:hover {
    width: 14dp;
    height: 14dp;
    margin: 1dp -7dp 0dp -7dp;
    background-color: #FFFFFF;
    border-radius: 7dp;
}
.stream-fps {
    display: flex;
    width: 66dp;
    height: 32dp;
    align-items: center;
    justify-content: flex-start;
    gap: 0dp;
    margin: 0dp;
    padding: 0dp 7dp;
    box-sizing: border-box;
    background-color: #0A0E14;
    border: 1dp var(--color-border);
    border-radius: 9dp;
    color: var(--color-text-soft);
}
.stream-fps-value { display: inline-block; width: 30dp; text-align: right; font-size: 11dp; font-weight: bold; }
.stream-fps-unit { display: inline-block; margin-left: 4dp; color: var(--color-text-faint); font-size: 7dp; font-weight: bold; letter-spacing: 0.5dp; }
.stream-grid { gap: 10dp; margin-top: 0dp; align-content: stretch; overflow: hidden; }
.stream-grid .stream-cell {
    flex: 1 1 45%;
    min-width: 300dp;
    min-height: 0dp;
    margin: 0dp;
    padding: 0dp;
    background-color: var(--color-surface);
    border: 1dp var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
}
.stream-grid.single .stream-cell { flex-basis: 100%; }
.stream-grid.pair .stream-cell { flex-basis: 45%; }
.stream-grid.trio .stream-cell { flex-basis: 45%; }
.stream-grid.many .stream-cell { flex-basis: 30%; }
.stream-grid .stream-cell-label { padding: 9dp 12dp; }
.stream-call-dock {
    display: flex;
    position: absolute;
    left: 50%;
    bottom: 14dp;
    width: 214dp;
    margin-left: -107dp;
    height: 52dp;
    align-items: center;
    justify-content: center;
    padding: 0dp 8dp;
    box-sizing: border-box;
    background-color: #11161EEB;
    border: 1dp #FFFFFF1A;
    border-radius: 17dp;
}
.dock-controls { display: flex; justify-content: center; gap: 6dp; }
.dock-button {
    display: flex;
    width: 42dp;
    height: 36dp;
    align-items: center;
    justify-content: center;
    padding: 0dp;
    background-color: #1A212C;
    border: 1dp transparent;
    border-radius: 10dp;
    cursor: pointer;
}
.dock-button svg { display: block; image-color: var(--color-text-soft); }
.dock-button:hover { background-color: #232D3A; }
.dock-button:hover svg { image-color: #FFFFFF; }
.dock-button.active { background-color: #17312D; border-color: #5EEAD433; }
.dock-button.active svg { image-color: var(--color-accent); }
.dock-button.danger { background-color: #3B1D23; border-color: #F871712B; }
.dock-button.danger svg { image-color: #FCA5A5; }
.dock-end-streams { background-color: #3B1D23; border-color: #F8717138; }
.dock-end-streams svg { image-color: #FCA5A5; }
.dock-end-streams:hover { background-color: #54242C; }

@media (max-width: 1280dp) {
    .screen-share-area { padding-left: 10dp; padding-right: 10dp; }
    .screen-share-header { padding-left: 10dp; padding-right: 10dp; }
    .stream-grid {
        flex-direction: column;
        flex-wrap: nowrap;
        overflow-y: auto;
    }
    .stream-grid .stream-cell {
        flex: 0 0 48%;
        width: auto;
        min-width: 0dp;
        min-height: 320dp;
    }
    .stream-grid.single .stream-cell { flex: 1 1 100%; }
    .stream-volume-control { width: 108dp; }
}

/* Share picker -------------------------------------------------------------- */
.share-picker-overlay { padding: 0dp; overflow: hidden; background-color: var(--color-canvas); }
.share-picker-header {
    display: flex;
    flex-shrink: 0;
    min-height: 112dp;
    align-items: center;
    margin: 0dp;
    padding: 18dp 24dp;
    border-bottom: 1dp var(--color-border);
}
.share-picker-header h2 { margin: 4dp 0dp; font-size: 23dp; }
.share-picker-kicker { color: var(--color-accent); font-size: 9dp; font-weight: bold; letter-spacing: 1dp; text-transform: uppercase; }
.share-picker-subtitle { color: var(--color-text-muted); font-size: 10dp; }
.share-close { padding: 8dp 10dp; color: var(--color-text-muted); border: 1dp var(--color-border); border-radius: var(--radius-sm); cursor: pointer; font-size: 9dp; }
.share-picker-scroll { display: flex; flex: 1; flex-direction: column; padding: 18dp 24dp 88dp 24dp; overflow-y: auto; }
.share-picker-section { margin-bottom: 18dp; }
.share-picker-section-heading { display: flex; justify-content: space-between; margin-bottom: 9dp; color: var(--color-text); font-size: 11dp; font-weight: bold; }
.share-picker-section-heading span:last-child { color: var(--color-text-faint); font-size: 9dp; font-weight: normal; }
.share-target-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 11dp; }
.share-target-card {
    display: flex;
    position: relative;
    flex-direction: column;
    width: 250dp;
    padding: 7dp;
    background-color: var(--color-surface);
    border: 1dp var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
}
.share-target-card:hover { background-color: var(--color-surface-raised); border-color: #FFFFFF24; }
.share-target-card.selected { background-color: #10201E; border-color: var(--color-accent); }
.share-target-preview { display: flex; position: relative; height: 118dp; overflow: hidden; align-items: center; justify-content: center; background-color: #111722; border-radius: 8dp; }
.share-target-fallback { color: var(--color-text-faint); font-size: 9dp; }
.share-target-thumbnail {
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 100%;
    height: 100%;
    background-color: transparent;
}
.share-target-meta { display: flex; flex-direction: column; padding: 8dp 3dp 2dp 3dp; }
.share-target-name { color: var(--color-text-soft); font-size: 10dp; overflow: hidden; white-space: nowrap; }
.share-target-kind { margin-top: 3dp; color: var(--color-text-faint); font-size: 8dp; }
.share-target-check { display: none; position: absolute; top: 14dp; right: 14dp; width: 20dp; height: 20dp; padding-top: 3dp; background-color: var(--color-accent); color: var(--color-accent-ink); border-radius: 11dp; text-align: center; font-size: 10dp; font-weight: bold; }
.share-target-card.selected .share-target-check { display: block; }
.share-picker-footer {
    display: flex;
    position: absolute;
    left: 0dp;
    right: 0dp;
    bottom: 0dp;
    height: 70dp;
    align-items: center;
    justify-content: flex-end;
    padding: 0dp 24dp;
    background-color: #0D1118F5;
    border-top: 1dp var(--color-border);
}
.share-picker-footer-actions { display: flex; gap: 9dp; }
.share-picker-footer .btn { width: auto; margin: 0dp; padding: 10dp 17dp; }
.share-start-button { background-color: var(--color-accent); color: var(--color-accent-ink); font-weight: bold; }
.share-start-button:hover { background-color: var(--color-accent-hover); }
.share-start-button.disabled {
    opacity: 1;
    background-color: #25312F;
    color: #B8C5C2;
    border: 1dp #FFFFFF12;
}

/* Member detail ------------------------------------------------------------- */
.user-menu-backdrop {
    top: var(--titlebar-height);
    justify-content: center;
    align-items: center;
    background-color: #05070BB8;
}
.user-menu-popup {
    width: 470dp;
    margin: 0dp;
    background-color: var(--color-surface);
    border: 1dp #FFFFFF1A;
    border-radius: 18dp;
}
.user-menu-header { padding: 18dp 20dp; background-color: #131923; border-bottom: 1dp var(--color-border); }
.user-menu-identity { display: flex; align-items: center; position: relative; }
.user-menu-avatar { width: 54dp; height: 54dp; flex-shrink: 0; margin-right: 13dp; }
.user-menu-presence { position: absolute; left: 40dp; bottom: 0dp; width: 10dp; height: 10dp; background-color: var(--color-success); border: 3dp #131923; border-radius: 8dp; }
.user-menu-name { font-size: 17dp; }
.user-menu-status { display: block; margin-top: 4dp; color: var(--color-text-muted); font-size: 10dp; }
.user-menu-role-row { display: flex; align-items: center; gap: 7dp; padding: 10dp 20dp; border-bottom: 1dp var(--color-border); }
.member-role { padding: 4dp 7dp; background-color: #1D2530; color: var(--color-text-muted); border-radius: 6dp; font-size: 8dp; font-weight: bold; text-transform: uppercase; }
.member-role.admin { background-color: #29213A; color: #C4B5FD; }
.member-role.owner { background-color: #332A17; color: #FCD34D; }
.member-role.moderator { background-color: #17312D; color: var(--color-accent); }
.member-connection { margin-left: auto; color: var(--color-success); font-size: 8dp; }
.user-menu-section { padding: 16dp 20dp; border-bottom: 1dp var(--color-border); }
.user-menu-section-title { margin-bottom: 10dp; color: var(--color-text-faint); font-size: 8dp; font-weight: bold; letter-spacing: 1dp; text-transform: uppercase; }
.user-menu-slider-row { min-height: 34dp; }
.user-menu-sublabel { min-width: 105dp; color: var(--color-text-soft); font-size: 10dp; }
.user-menu-value { width: 38dp; color: var(--color-text-muted); font-size: 9dp; text-align: right; }
.user-menu-option { display: flex; align-items: center; justify-content: space-between; margin-top: 10dp; padding: 11dp 12dp; background-color: #151B25; border: 1dp var(--color-border); border-radius: 10dp; cursor: pointer; }
.user-menu-option-copy { display: block; margin-top: 3dp; color: var(--color-text-faint); font-size: 8dp; }
.user-menu-actions { padding: 14dp 20dp; }
.user-menu-action { justify-content: space-between; padding: 9dp 10dp; border-radius: 8dp; }
.action-chevron { color: var(--color-text-faint); }
.user-menu-footer { padding: 10dp 20dp 16dp 20dp; border-top: 1dp var(--color-border); }
.user-menu-footer .user-menu-action.danger { justify-content: space-between; background-color: #3B1D232E; border: 1dp #F8717133; }

/* Independent frameless HWND context surfaces ------------------------------ */
body.context-window-root {
    display: flex;
    width: 100%;
    height: auto;
    margin: 0dp;
    padding: 0dp;
    background-color: #0D1118;
    color: var(--color-text);
    font-family: Inter;
    overflow: hidden;
}
.context-window-shell {
    display: flex;
    width: 100%;
    height: auto;
    flex-direction: column;
    box-sizing: border-box;
    background-color: #0D1118;
    border: 1dp #FFFFFF1F;
    border-radius: 14dp;
    overflow: hidden;
}
.context-window-header {
    display: flex;
    min-height: 72dp;
    flex-shrink: 0;
    align-items: center;
    padding: 12dp 14dp;
    box-sizing: border-box;
    background-color: #131923;
    border-bottom: 1dp var(--color-border);
}
.context-window-avatar {
    display: flex;
    width: 42dp;
    height: 42dp;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: #1B3A34;
    color: var(--color-accent);
    border: 1dp #5EEAD447;
    border-radius: 12dp;
    font-size: 12dp;
    font-weight: bold;
}
.context-window-identity { display: flex; min-width: 0dp; flex: 1; flex-direction: column; margin-left: 11dp; }
.context-window-title { color: var(--color-text); font-size: 14dp; font-weight: bold; overflow: hidden; white-space: nowrap; }
.context-window-subtitle { margin-top: 3dp; color: var(--color-text-muted); font-size: 9dp; overflow: hidden; white-space: nowrap; }
.context-window-close {
    display: flex;
    width: 28dp;
    height: 28dp;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: #171D27;
    color: var(--color-text-muted);
    border: 1dp var(--color-border);
    border-radius: 8dp;
    cursor: pointer;
}
.context-window-close:hover { background-color: #222A36; color: var(--color-text); }
.context-window-role { display: flex; align-items: center; padding: 8dp 14dp; border-bottom: 1dp var(--color-border); }
.context-window-role > span:first-child { padding: 4dp 7dp; background-color: #1D2530; color: #C4B5FD; border-radius: 6dp; font-size: 8dp; font-weight: bold; text-transform: uppercase; }
.context-window-secure { margin-left: auto; color: var(--color-success); font-size: 8dp; }
.context-window-audio { display: flex; flex-direction: column; padding: 13dp 14dp; border-bottom: 1dp var(--color-border); }
.context-window-section-title { color: var(--color-text-faint); font-size: 8dp; font-weight: bold; letter-spacing: 1dp; text-transform: uppercase; }
.context-window-volume-row { display: flex; height: 34dp; align-items: center; gap: 9dp; margin-top: 6dp; color: var(--color-text-soft); font-size: 10dp; }
.context-window-volume-row > span:first-child { width: 92dp; flex-shrink: 0; }
input.context-window-slider { display: block; min-width: 0dp; flex: 1; height: 16dp; }
input.context-window-slider slidertrack { height: 5dp; margin-top: 5dp; background-color: #080C12; border-radius: 4dp; }
input.context-window-slider sliderprogress { height: 5dp; background-color: var(--color-accent); border-radius: 4dp; }
input.context-window-slider sliderbar { width: 13dp; height: 13dp; margin-top: 1dp; margin-left: -6dp; background-color: #FFFFFF; border: 0dp; border-radius: 7dp; }
.context-window-value { display: flex; width: 48dp; height: 27dp; flex-shrink: 0; align-items: center; justify-content: center; background-color: #171D27; border: 1dp var(--color-border); border-radius: 7dp; }
.context-window-value > span { display: block; color: var(--color-text-soft); font-size: 9dp; font-weight: bold; }
.context-window-option { display: flex; align-items: center; justify-content: space-between; margin-top: 7dp; padding: 10dp 11dp; background-color: #151B25; border: 1dp var(--color-border); border-radius: 9dp; cursor: pointer; }
.context-window-option > div { display: flex; min-width: 0dp; flex-direction: column; }
.context-window-option b { color: var(--color-text-soft); font-size: 10dp; }
.context-window-option small { display: block; margin-top: 3dp; color: var(--color-text-faint); font-size: 8dp; }
.context-window-target { display: flex; align-items: center; gap: 10dp; margin-top: 8dp; color: var(--color-text-muted); font-size: 9dp; }
.context-window-target > span { width: 76dp; flex-shrink: 0; }
.context-window-actions { display: flex; flex-grow: 0; flex-shrink: 0; flex-direction: column; padding: 8dp; }
.context-window-action { display: flex; min-height: 48dp; align-items: center; justify-content: space-between; padding: 8dp 10dp; box-sizing: border-box; border-radius: 9dp; cursor: pointer; }
.context-window-action:hover { background-color: #18202B; }
.context-window-action > div { display: flex; min-width: 0dp; flex-direction: column; }
.context-window-action b { color: var(--color-text-soft); font-size: 11dp; }
.context-window-action small { display: block; margin-top: 3dp; color: var(--color-text-faint); font-size: 8dp; }
.context-window-action > span { color: var(--color-text-faint); font-size: 16dp; }
.context-window-action.danger b, .context-window-action.danger > span { color: #F87171; }
.context-window-action.danger:hover { background-color: #3B1D234D; }
.context-window-separator { height: 1dp; margin: 5dp 9dp; background-color: var(--color-border); }

/* Onboarding --------------------------------------------------------------- */
.onboarding-backdrop { top: var(--titlebar-height); background-color: var(--color-canvas); }
.onboarding-shell { display: flex; width: 100%; height: 100%; background-color: var(--color-canvas); }
.onboarding-story {
    display: flex;
    flex-direction: column;
    width: 42%;
    padding: 42dp 48dp;
    box-sizing: border-box;
    background-color: #0E151A;
    border-right: 1dp var(--color-border);
}
.onboarding-brand { display: flex; align-items: center; gap: 10dp; color: var(--color-text); font-size: 15dp; font-weight: bold; letter-spacing: 0.5dp; }
.onboarding-story-copy { margin-top: 105dp; max-width: 430dp; }
.onboarding-eyebrow { color: var(--color-accent); font-size: 9dp; font-weight: bold; letter-spacing: 1.4dp; text-transform: uppercase; }
.onboarding-story h1 { margin: 16dp 0dp; color: #F5F7FA; font-size: 38dp; line-height: 1.12; letter-spacing: -1dp; }
.onboarding-story p { color: #84909E; font-size: 13dp; line-height: 1.55; }
.onboarding-proof { display: flex; flex-direction: column; gap: 11dp; margin-top: 46dp; }
.onboarding-proof div { display: flex; align-items: center; padding: 11dp 13dp; background-color: #111C21; border: 1dp #FFFFFF0C; border-radius: 10dp; }
.onboarding-proof span { color: var(--color-accent); font-size: 9dp; font-weight: bold; margin-right: 12dp; }
.onboarding-proof p { color: var(--color-text-soft); font-size: 10dp; }
.onboarding-story-footer { margin-top: auto; color: #4C5A64; font-size: 9dp; }
.onboarding-recovery-aside { display: flex; flex-direction: column; margin-top: 94dp; }
.recovery-aside-mark { display: flex; width: 64dp; height: 64dp; align-items: center; justify-content: center; margin-bottom: 28dp; background-color: #142522; color: var(--color-accent); border: 1dp #5EEAD440; border-radius: 18dp; font-size: 22dp; font-weight: bold; }
.onboarding-recovery-aside h1 { margin-top: 14dp; }
.recovery-aside-rule { width: 74dp; height: 2dp; margin: 28dp 0dp 14dp 0dp; background-color: var(--color-accent); }
.onboarding-recovery-aside .recovery-aside-detail { color: #52616B; font-size: 9dp; }
.onboarding-main { display: flex; position: relative; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 38dp 70dp; }
.onboarding-progress { display: flex; position: absolute; right: 38dp; top: 30dp; gap: 6dp; }
.onboarding-progress span { width: 24dp; height: 3dp; background-color: #252C35; border-radius: 2dp; }
.onboarding-progress span.active { background-color: var(--color-accent); }
.onboarding-choice, .onboarding-form, .onboarding-recovery { display: flex; flex-direction: column; width: 560dp; }
.onboarding-step-label { margin-bottom: 9dp; color: var(--color-accent); font-size: 9dp; font-weight: bold; letter-spacing: 1dp; text-transform: uppercase; }
.onboarding-main h1 { margin: 0dp 0dp 8dp 0dp; font-size: 27dp; }
.onboarding-lead { margin-bottom: 24dp; color: var(--color-text-muted); font-size: 12dp; }
.identity-path { display: flex; align-items: center; min-height: 74dp; margin-bottom: 10dp; padding: 14dp 16dp; background-color: var(--color-surface); border: 1dp var(--color-border); border-radius: 13dp; cursor: pointer; }
.identity-path:hover { background-color: var(--color-surface-raised); border-color: #FFFFFF26; }
.identity-path.primary { border-color: #5EEAD44A; background-color: #10201E; }
.identity-path-icon { display: flex; width: 42dp; height: 42dp; flex-shrink: 0; align-items: center; justify-content: center; margin-right: 13dp; background-color: #1B242E; color: var(--color-accent); border-radius: 11dp; font-size: 14dp; font-weight: bold; }
.identity-path h2 { margin: 0dp 0dp 4dp 0dp; font-size: 13dp; }
.identity-path p { color: var(--color-text-muted); font-size: 9dp; }
.identity-path-arrow { margin-left: auto; color: var(--color-text-faint); font-size: 20dp; }
.onboarding-security-note { display: flex; align-items: center; margin-top: 8dp; color: var(--color-text-faint); font-size: 9dp; }
.onboarding-security-note .security-check { margin-right: 8dp; color: var(--color-success); }
.onboarding-back { margin-bottom: 22dp; color: var(--color-text-muted); font-size: 10dp; cursor: pointer; }
.recovery-input { width: 100%; min-height: 70dp; margin: 0dp 0dp 14dp 0dp; padding: 14dp; box-sizing: border-box; background-color: var(--color-surface); border: 1dp var(--color-border-strong); border-radius: 10dp; color: var(--color-text); }
.onboarding-primary { width: auto; margin: 12dp 0dp 0dp 0dp; padding: 12dp 18dp; align-self: flex-start; }
.enterprise-seed { margin: 0dp; padding: 18dp; background-color: var(--color-surface); border: 1dp #5EEAD43D; border-radius: 13dp; }
.seed-card-label { display: flex; justify-content: space-between; margin-bottom: 14dp; color: var(--color-text-faint); font-size: 8dp; font-weight: bold; letter-spacing: 0.8dp; text-transform: uppercase; }
.enterprise-seed .seed-phrase-text { color: #DDFBF6; font-size: 15dp; line-height: 1.8; letter-spacing: 0.4dp; }
.seed-card-actions { display: flex; margin-top: 14dp; }
.recovery-warning { display: flex; align-items: center; margin-top: 13dp; padding: 11dp 13dp; background-color: #2A2315; border: 1dp #FBBF2430; border-radius: 10dp; }
.recovery-warning span { display: flex; width: 22dp; height: 22dp; flex-shrink: 0; align-items: center; justify-content: center; margin-right: 10dp; background-color: #4A3613; color: var(--color-warning); border-radius: 12dp; font-weight: bold; }
.recovery-warning p { color: #C0A971; font-size: 9dp; line-height: 1.4; }

/* Connect dialog ----------------------------------------------------------- */
.party-connect-dialog { width: 720dp; padding: 0dp; overflow: hidden; background-color: var(--color-surface); border-color: #FFFFFF1A; border-radius: 18dp; }
.party-connect-header { display: flex; align-items: center; justify-content: space-between; padding: 22dp 24dp 16dp 24dp; }
.party-connect-header h1 { margin: 4dp 0dp 0dp 0dp; font-size: 20dp; }
.modal-kicker { color: var(--color-accent); font-size: 8dp; font-weight: bold; letter-spacing: 1dp; text-transform: uppercase; }
.party-connect-tabs { display: flex; gap: 5dp; padding: 0dp 24dp 12dp 24dp; border-bottom: 1dp var(--color-border); }
.party-connect-tabs span { padding: 8dp 11dp; color: var(--color-text-muted); border-radius: 8dp; font-size: 9dp; }
.party-connect-tabs span.active { background-color: #17221F; color: var(--color-accent); }
.party-connect-body { display: flex; gap: 22dp; padding: 22dp 24dp; }
.party-connect-form { flex: 1; }
.party-connect-form .label { margin-top: 0dp; margin-bottom: 6dp; }
.party-connect-form input { width: 100%; margin-bottom: 14dp; padding: 11dp 12dp; box-sizing: border-box; background-color: #0D1118; color: var(--color-text); border: 1dp var(--color-border-strong); border-radius: 9dp; }
.connection-security { display: flex; margin-top: 8dp; padding: 11dp; background-color: #10201E; border: 1dp #5EEAD42B; border-radius: 9dp; }
.connection-security > span { margin-right: 9dp; color: var(--color-success); }
.connection-security b { color: var(--color-text-soft); font-size: 9dp; }
.connection-security p { margin-top: 3dp; color: var(--color-text-faint); font-size: 8dp; line-height: 1.4; }
.party-connect-preview { display: flex; width: 250dp; flex-direction: column; align-items: center; justify-content: center; padding: 18dp; background-color: #0D1118; border: 1dp var(--color-border); border-radius: 12dp; }
.preview-label { align-self: flex-start; margin-bottom: 18dp; color: var(--color-text-faint); font-size: 8dp; text-transform: uppercase; }
.preview-party-logo { display: flex; width: 58dp; height: 58dp; align-items: center; justify-content: center; background-color: #253E4B; color: #BDF7ED; border-radius: 17dp; font-size: 18dp; font-weight: bold; }
.party-connect-preview h2 { margin: 12dp 0dp 4dp 0dp; }
.party-connect-preview p { color: var(--color-text-faint); font-size: 8dp; }
.preview-meta { display: flex; align-items: center; gap: 6dp; margin-top: 16dp; color: var(--color-text-muted); font-size: 8dp; }
.party-connect-footer { display: flex; justify-content: flex-end; gap: 9dp; padding: 14dp 24dp; background-color: #0D1118; border-top: 1dp var(--color-border); }
.party-connect-footer .btn { width: auto; margin: 0dp; padding: 10dp 15dp; }
